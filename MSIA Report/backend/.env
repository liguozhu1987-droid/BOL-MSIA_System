# MSIA 审核管理系统 - 环境变量示例
# 复制为 .env 并按需修改

# 主数据库 (SQL Server) - SQLAlchemy 连接串
DATABASE_URL=mssql+pyodbc://ytview:Inalfa%402021@IRSCNYTFINEREPORT.ap.inalfa.local/CN_AME?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# HR 数据库 - pyodbc 原生连接串 (用于用户同步)
HRDB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=IRSCNYTFINEREPORT.ap.inalfa.local;DATABASE=HRDB;UID=ytview;PWD=Inalfa@2021;TrustServerCertificate=yes;

# 邮件 SMTP 配置 (内网 SMTP, 无认证, 明文模式)
EMAIL_SMTP_HOST=172.19.253.10
EMAIL_SMTP_PORT=25
EMAIL_ENABLE_SSL=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=msia-noreply@inalfa.local
EMAIL_FROM_DISPLAY_NAME=MSIA 审核管理系统
EMAIL_TIMEOUT_MS=30000

# JWT 配置
# 注意: JWT 密钥/算法/有效期统一以 config.ini [security] 为准,
# config.ini 会在启动时注入环境变量, 优先级高于本文件, 此处不重复配置以免歧义

# 文件存储路径
STORAGE_PATH=./storage

# CORS 允许来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173

# 系统访问 URL (邮件正文中的 "访问地址" 链接, 部署后改为用户实际访问的登录页地址)
# 为空时回退到 CORS_ORIGINS 的第一项
SYSTEM_URL=http://172.26.2.203:8078/login

# 应用监听
APP_HOST=0.0.0.0
APP_PORT=8000

# 开发环境自动建表 (生产环境关闭)
MSIA_AUTO_CREATE_TABLES=1
