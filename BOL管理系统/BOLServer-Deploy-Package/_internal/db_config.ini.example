; BOL 管理分析平台 - 数据库连接配置文件
;
; 使用方法：
;   1. 复制本文件为 db_config.ini
;   2. 修改以下参数为实际值
;   3. 将 db_config.ini 放置在以下任一位置：
;      - PyInstaller 打包环境：BOLServer.exe 同目录
;      - 普通部署环境：backend 目录
;   4. 或通过环境变量 BOL_DB_CONFIG 指定路径
;
; 注意：如不创建 db_config.ini，系统将使用 settings.py 中的默认值

[database]
; SQL Server 服务器地址（含端口）
host = IRSCNYTFINEREPORT.ap.inalfa.local,1433

; 数据库用户名
user = sparePartRead

; 数据库密码
password = Inalfa@2026

; ODBC 驱动名称（根据服务器已安装的驱动选择）
;   常见值：
;   - ODBC Driver 17 for SQL Server
;   - ODBC Driver 18 for SQL Server
;   - SQL Server Native Client 11.0
;   - SQL Server
driver = ODBC Driver 18 for SQL Server

; 额外连接参数
;   TrustServerCertificate=yes  信任服务器证书（避免证书验证错误）
;   Encrypt=no                  关闭加密（内网环境）
extra_params = TrustServerCertificate=yes;Encrypt=no;Connection Timeout=30;

[email]
; 邮件服务器地址（公司内部邮件服务器）
host = 172.19.253.10

; 邮件服务器端口
port = 25

; 是否使用 SSL 加密（True/False）
use_ssl = True

; 是否使用 TLS 加密（True/False，与 SSL 互斥）
use_tls = False

; 邮箱账号（内部邮件服务器无密码，留空即可）
user =

; 邮箱密码（无密码留空）
password =

; 发件人邮箱地址
from_email = BOL管理系统 <bol-system@inalfa.local>

; 管理员邮箱（接收改善分析报告，多个用逗号分隔）
; 部署时请修改为实际管理员邮箱地址
admin_email =
