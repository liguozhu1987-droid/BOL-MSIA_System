# Claude Code EdgeFn API 密钥配置

# ============ 在这里输入你的 API Key ============
# 将 YOUR_API_KEY_HERE 替换为你从 EdgeFn 获取的实际 API Key

API_KEY="YOUR_API_KEY_HERE"

# ===============================================

# LiteLLM 配置文件 - 请编辑此文件并填入你的 API Key

model_list:
  - model_name: deepseek-v3
    litellm_params:
      model: openai/deepseek-v3.2
      api_key: "${sk-RIfE7nc3oI4woVeTA8A24e80E15b4e4d8c516855123b5b19}"
      api_base: "https://api.edgefn.net/v1"
